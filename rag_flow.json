      "name": "Respond - Embedding Error"
    },
    {
      "parameters": {
        "jsCode": "const qdrantResults = $input.first().json;\n\n// Extract context chunks from Qdrant results\nconst hits = qdrantResults.result ?? [];\n\nconsole.log('Qdrant hits:', hits.length);\n\nconst context = hits\n  .map((hit, i) => {\n    const text = hit.payload?.text ?? hit.payload?.content ?? JSON.stringify(hit.payload);\n    console.log(`Context ${i + 1}:`, text.substring(0, 100));\n    return `[${i + 1}] ${text}`;\n  })\n  .join(\"\\n\\n\");\n\n// Retrieve the original user message - try multiple sources\nlet userMessage = \"\";\ntry {\n  userMessage = $('Normalize Embedding').first().json.message || \"\";\n} catch (e) {\n  console.log('Could not get message from Normalize Embedding');\n}\n\nif (!userMessage) {\n  try {\n    userMessage = $('Extract input').first().json.body?.message || \"\";\n  } catch (e) {\n    console.log('Could not get message from Extract input');\n  }\n}\n\nif (!userMessage) {\n  userMessage = \"No user message found\";\n}\n\nconsole.log('User message:', userMessage);\nconsole.log('Context length:', context.length);\n\nconst prompt = `You are a friendly and professional assistant for Horizon Digital, a web design company in Seychelles. Your goal is to help potential clients quickly understand our services.\n\nRESPONSE GUIDELINES:\n- Be warm, conversational, and helpful\n- Keep answers BRIEF and focused (2-3 sentences max for main answer)\n- ALWAYS use bullet points for ALL lists - NEVER use paragraphs\n- Each bullet point must be exactly 1 line - no exceptions\n- Start each bullet point with \"•\" (bullet character) and space after\n- Focus on the most important information first\n- If they ask about packages, format: \"• Package Name - Key feature + SCR price\"\n- If they ask about services, format: \"• Service Name - 1-line description\"\n- End with a simple question if more detail is needed\n- Avoid long explanations or feature dumps\n- If mentioning prices, always include the currency (SCR)\n- Format: Clean, scannable, easy to read\n\nEXAMPLES:\nQ: \"What packages do you offer?\"\nA: \"We offer 3 main packages:\n• Foundation - 5-page website + basic SEO - SCR 7,500\n• Starter - 10-page website + WhatsApp integration - SCR 15,000\n• Growth - 20-page website + blog + testimonials - SCR 30,000\n\nWhich package interests you?\"\n\nQ: \"What services do you provide?\"\nA: \"We provide comprehensive web services:\n• Website Design & Refresh - Modern design and performance improvements\n• Technical & Hosting - Managed hosting at SCR 250/month or SCR 2,500/year\n• Digital Marketing - SEO and online presence optimization\n\nNeed details on any service?\"\n\nCONTEXT:\n${context}\n\nUSER QUESTION:\n${userMessage}\n\nANSWER:`;\n\n// Pre-serialize the body so Ollama Generate node receives a clean JSON string\nconst body = JSON.stringify({\n  model: \"llama3.2:3b\",\n  prompt: prompt,\n  stream: false\n});\n\nconsole.log('Generated prompt length:', prompt.length);\n\nreturn [{ json: { prompt, body } }];"
      },
