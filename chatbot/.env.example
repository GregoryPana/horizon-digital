COMPOSE_PROJECT_NAME=horizon_chatbot

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY=replace_with_32_plus_chars
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/

# LLM/Embeddings
OLLAMA_BASE_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text:latest
LOCAL_CHAT_MODEL=llama3.1:8b

# Qdrant
QDRANT_COLLECTION=horizon_digital

# Optional for Phase 2 (cloud synthesis)
GROQ_API_KEY=
OPENAI_API_KEY=
