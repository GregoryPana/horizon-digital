        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: \"llama-3.1-8b-instant\",\n  messages: [\n    { role: \"system\", content: \"You are Horizon Digital's assistant. Answer only from provided context, keep it concise, and use bullet points for lists.\" },\n    { role: \"user\", content: $json.body?.prompt ?? $json.prompt ?? \"\" }\n  ],\n  temperature: 0.2,\n  max_tokens: 450\n} }}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
