      "id": "2d917d27-8b5e-465e-ac0a-4595b5251fca",
      "name": "Groq Generate"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json || {};\nconst rawReply = String(data.choices?.[0]?.message?.content || \"Sorry, I could not generate a response right now.\");\n\nconst formattedReply = rawReply\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\\\n/g, '\\n')\n  .replace(/:\\s*•/g, ':\\n•')\n  .replace(/\\s+•\\s+/g, '\\n• ')\n  .replace(/\\s+-\\s+/g, '\\n- ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn [{\n  json: {\n    reply: formattedReply,\n    response: formattedReply,\n    model: data.model || \"llama-3.1-8b-instant\",\n    usage: data.usage || null,\n    provider: \"groq\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
