      "id": "541c5a75-2275-4396-961c-b2e362b2eb31",
      "name": "Ollama Embed"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const embedding = item.json.embedding;\n\n  if (!embedding || !Array.isArray(embedding) || embedding.length === 0) {\n    results.push({ json: { ok: false, error: \"No embedding returned from Ollama\" } });\n    continue;\n  }\n\n  // Compute L2 norm\n  const norm = Math.sqrt(embedding.reduce((sum, val) => sum + val * val, 0));\n\n  // Normalize to unit vector (avoid division by zero)\n  const normalized = norm > 0 ? embedding.map(v => v / norm) : embedding;\n\n  results.push({\n    json: {\n      ok: true,\n      embedding: normalized,\n      // Pass through the original message if needed downstream\n      message: item.json.prompt ?? \"\"\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2608,
        1712
      ],
