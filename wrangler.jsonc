{
  "name": "horizon-digital",
  "compatibility_date": "2026-02-21",
  "main": "./src/worker.ts",
  "routes": [
    {
      "pattern": "horizondigitalsey.com/*",
      "zone_name": "horizondigitalsey.com"
    },
    {
      "pattern": "www.horizondigitalsey.com/*",
      "zone_name": "horizondigitalsey.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
